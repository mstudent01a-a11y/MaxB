body {
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    background-color: #f4f4f9;
    margin: 0;
    padding: 0;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 100vh;
}

.container {
    text-align: center;
    max-width: 800px;
    padding: 20px;
}

h1 {
    font-size: 2.5rem;
    color: #2c3e50;
    margin-bottom: 15px;
}

p {
    font-size: 1.1rem;
    color: #555;
    margin-bottom: 30px;
}

.poster {
    max-width: 100%;
    height: auto;
    border-radius: 10px;
    box-shadow: 0 8px 20px rgba(0,0,0,0.2);
}

.btn-buy {
    display: inline-block;
    margin-top: 25px;
    padding: 12px 28px;
    font-size: 1.1rem;
    color: #fff;
    background-color: #000;
    text-decoration: none;
    border-radius: 6px;
    transition: background-color 0.3s, transform 0.2s;
}

.btn-buy:hover {
    background-color: #333;
    transform: translateY(-2px);
}
